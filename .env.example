# MariFindX Environment Variables

# API Configuration (for future backend integration)
VITE_API_BASE_URL=http://localhost:3000/api

# Sentinel-1 Satellite Data
VITE_SENTINEL_API_KEY=your_sentinel_key_here

# AIS Data Provider
VITE_AIS_API_KEY=your_ais_key_here

# Map Configuration
VITE_MAP_TILE_URL=https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png

# Application Settings
VITE_APP_NAME=MariFindX
VITE_APP_VERSION=1.0.0
VITE_DEBUG_MODE=false

# Feature Flags
VITE_ENABLE_3D=true
VITE_ENABLE_REAL_TIME_AIS=false
VITE_ENABLE_SENTINEL_IMAGERY=false
