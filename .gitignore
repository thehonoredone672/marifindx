# --- Node / frontend ---
node_modules/
dist/
dist-ssr/
*.local
.vite/

# --- Python ---
__pycache__/
*.py[cod]
*.so
.venv/
venv/
env/
.Python
*.egg-info/
.pytest_cache/
.ipynb_checkpoints/

# --- Environment ---
.env
.env.local
.env.*.local

# --- Trained artefacts (large binaries; regenerate with ml.train) ---
models/*.pt
models/*.onnx
models/*.pth

# --- Generated results (regenerate with ml.test / ml.inference) ---
results/
!results/.gitkeep

# --- Datasets (never commit; see README for Zenodo download) ---
data/raw/
data/processed/
data/demo/*.tif
data/demo/*.tiff
data/synthetic/*.csv

# --- IDE / OS ---
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db

# --- Logs ---
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
